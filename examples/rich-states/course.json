{
  "schema_version": 1,
  "id": "rich-states",
  "title": "Rich Object States Showcase",
  "slide_size": { "w": 1280, "h": 720 },
  "theme": {
    "accent": "#2563EB",
    "background": "#F8FAFC",
    "text": "#0F172A",
    "font": "Inter",
    "palette": [
      { "id": "brand-blue", "name": "Brand Blue", "color": "#2563EB" },
      { "id": "brand-sky", "name": "Brand Sky", "color": "#0EA5E9" }
    ]
  },
  "text_styles": [
    { "id": "heading", "name": "Heading", "style": { "size": 28.0, "bold": true, "color": "#0F172A" } },
    { "id": "accent_bold", "name": "Accent Bold", "style": { "size": 20.0, "bold": true, "color": "#1E3A8A" } }
  ],
  "quiz": {
    "passing_percent": 100
  },
  "scenes": [
    {
      "id": "sc-states",
      "title": "Rich Object States",
      "slides": [
        {
          "id": "s01-character",
          "title": "Expressive Character",
          "objects": [
            {
              "id": "s01-heading",
              "kind": { "type": "text", "text": "Meet Your Guide", "style": { "size": 32.0, "bold": true, "color": "#0F172A" } },
              "frame": { "x": 80, "y": 48, "w": 600, "h": 56 }
            },
            {
              "id": "obj-character",
              "kind": {
                "type": "image",
                "src": "media/char-neutral.svg",
                "alt": "Guide character"
              },
              "frame": { "x": 480, "y": 180, "w": 320, "h": 360 },
              "states": [
                {
                  "name": "hover",
                  "src": "media/char-wave.svg",
                  "glow": { "color": "#38BDF8", "size": 14.0 },
                  "extras": [
                    {
                      "id": "extra-bubble-bg",
                      "name": "Speech bubble",
                      "kind": {
                        "type": "shape",
                        "shape": "callout_rounded",
                        "fill": "#FFFFFF",
                        "outline": { "color": "#2563EB", "width": 2.0 }
                      },
                      "frame": { "x": 250, "y": -40, "w": 180, "h": 72 }
                    },
                    {
                      "id": "extra-bubble-txt",
                      "name": "Speech bubble text",
                      "kind": {
                        "type": "text",
                        "text": "Click me!",
                        "style": { "size": 18.0, "bold": true, "color": "#1E3A8A" }
                      },
                      "frame": { "x": 262, "y": -26, "w": 156, "h": 44 }
                    }
                  ]
                },
                {
                  "name": "down",
                  "src": "media/char-wave.svg",
                  "rotation": 3.0
                },
                {
                  "name": "selected",
                  "src": "media/char-celebrate.svg",
                  "extras": [
                    {
                      "id": "extra-star",
                      "name": "Celebration star",
                      "kind": {
                        "type": "path",
                        "closed": true,
                        "points": [
                          { "x": 0.50, "y": 0.05 },
                          { "x": 0.61, "y": 0.36 },
                          { "x": 0.94, "y": 0.36 },
                          { "x": 0.68, "y": 0.56 },
                          { "x": 0.78, "y": 0.89 },
                          { "x": 0.50, "y": 0.69 },
                          { "x": 0.22, "y": 0.89 },
                          { "x": 0.32, "y": 0.56 },
                          { "x": 0.06, "y": 0.36 },
                          { "x": 0.39, "y": 0.36 }
                        ],
                        "fill": "#FACC15",
                        "outline": { "color": "#CA8A04", "width": 2.0 }
                      },
                      "frame": { "x": -36, "y": -36, "w": 72, "h": 72 }
                    }
                  ]
                }
              ]
            },
            {
              "id": "s01-btn-next",
              "kind": { "type": "button", "label": "Next" },
              "frame": { "x": 1020, "y": 620, "w": 180, "h": 52 }
            }
          ],
          "triggers": [
            {
              "when": { "event": "click", "object": "obj-character" },
              "action": { "action": "change_state", "object": "obj-character", "state": "selected" }
            },
            {
              "when": { "event": "click", "object": "s01-btn-next" },
              "action": { "action": "jump_to_slide", "target": "next" }
            }
          ]
        },
        {
          "id": "s02-checklist",
          "title": "Visited Checklist & Unlock",
          "objects": [
            {
              "id": "s02-heading",
              "kind": { "type": "text", "text": "Explore All Three Topics", "style": { "size": 30.0, "bold": true, "color": "#0F172A" } },
              "frame": { "x": 80, "y": 48, "w": 720, "h": 52 }
            },
            {
              "id": "s02-topic-1",
              "kind": { "type": "button", "label": "Topic 1: Foundations" },
              "frame": { "x": 100, "y": 200, "w": 220, "h": 80 },
              "states": [
                {
                  "name": "visited",
                  "outline": { "color": "#16A34A", "width": 3.0 },
                  "extras": [
                    {
                      "id": "t1-check-bg",
                      "name": "Check badge",
                      "kind": { "type": "shape", "shape": "ellipse", "fill": "#16A34A" },
                      "frame": { "x": 200, "y": -12, "w": 28, "h": 28 }
                    },
                    {
                      "id": "t1-check-mark",
                      "name": "Checkmark",
                      "kind": {
                        "type": "path",
                        "points": [
                          { "x": 0.11, "y": 0.50 },
                          { "x": 0.39, "y": 0.78 },
                          { "x": 0.89, "y": 0.22 }
                        ],
                        "outline": { "color": "#FFFFFF", "width": 2.5 }
                      },
                      "frame": { "x": 205, "y": -7, "w": 18, "h": 18 }
                    }
                  ]
                },
                {
                  "name": "hover",
                  "glow": { "color": "#2563EB", "size": 12.0 }
                }
              ]
            },
            {
              "id": "s02-topic-2",
              "kind": { "type": "button", "label": "Topic 2: Layering" },
              "frame": { "x": 380, "y": 200, "w": 220, "h": 80 },
              "states": [
                {
                  "name": "visited",
                  "outline": { "color": "#16A34A", "width": 3.0 },
                  "extras": [
                    {
                      "id": "t2-check-bg",
                      "name": "Check badge",
                      "kind": { "type": "shape", "shape": "ellipse", "fill": "#16A34A" },
                      "frame": { "x": 200, "y": -12, "w": 28, "h": 28 }
                    },
                    {
                      "id": "t2-check-mark",
                      "name": "Checkmark",
                      "kind": {
                        "type": "path",
                        "points": [
                          { "x": 0.11, "y": 0.50 },
                          { "x": 0.39, "y": 0.78 },
                          { "x": 0.89, "y": 0.22 }
                        ],
                        "outline": { "color": "#FFFFFF", "width": 2.5 }
                      },
                      "frame": { "x": 205, "y": -7, "w": 18, "h": 18 }
                    }
                  ]
                },
                {
                  "name": "hover",
                  "glow": { "color": "#2563EB", "size": 12.0 }
                }
              ]
            },
            {
              "id": "s02-topic-3",
              "kind": { "type": "button", "label": "Topic 3: Accessibility" },
              "frame": { "x": 660, "y": 200, "w": 220, "h": 80 },
              "states": [
                {
                  "name": "visited",
                  "outline": { "color": "#16A34A", "width": 3.0 },
                  "extras": [
                    {
                      "id": "t3-check-bg",
                      "name": "Check badge",
                      "kind": { "type": "shape", "shape": "ellipse", "fill": "#16A34A" },
                      "frame": { "x": 200, "y": -12, "w": 28, "h": 28 }
                    },
                    {
                      "id": "t3-check-mark",
                      "name": "Checkmark",
                      "kind": {
                        "type": "path",
                        "points": [
                          { "x": 0.11, "y": 0.50 },
                          { "x": 0.39, "y": 0.78 },
                          { "x": 0.89, "y": 0.22 }
                        ],
                        "outline": { "color": "#FFFFFF", "width": 2.5 }
                      },
                      "frame": { "x": 205, "y": -7, "w": 18, "h": 18 }
                    }
                  ]
                },
                {
                  "name": "hover",
                  "glow": { "color": "#2563EB", "size": 12.0 }
                }
              ]
            },
            {
              "id": "s02-btn-continue",
              "kind": { "type": "button", "label": "Continue" },
              "frame": { "x": 1020, "y": 620, "w": 180, "h": 52 },
              "initial_state": "disabled",
              "states": [
                {
                  "name": "disabled",
                  "opacity": 0.45
                },
                {
                  "name": "hover",
                  "glow": { "color": "#2563EB", "size": 10.0 }
                }
              ]
            }
          ],
          "triggers": [
            {
              "when": { "event": "click", "object": "s02-topic-1" },
              "action": { "action": "change_state", "object": "s02-topic-1", "state": "visited" }
            },
            {
              "when": { "event": "click", "object": "s02-topic-2" },
              "action": { "action": "change_state", "object": "s02-topic-2", "state": "visited" }
            },
            {
              "when": { "event": "click", "object": "s02-topic-3" },
              "action": { "action": "change_state", "object": "s02-topic-3", "state": "visited" }
            },
            {
              "when": { "event": "state_changes", "object": "s02-topic-1" },
              "condition": {
                "all": [
                  { "object_state": { "object": "s02-topic-1", "state": "visited", "is": true } },
                  { "object_state": { "object": "s02-topic-2", "state": "visited", "is": true } },
                  { "object_state": { "object": "s02-topic-3", "state": "visited", "is": true } }
                ]
              },
              "action": { "action": "change_state", "object": "s02-btn-continue", "state": "normal" }
            },
            {
              "when": { "event": "state_changes", "object": "s02-topic-2" },
              "condition": {
                "all": [
                  { "object_state": { "object": "s02-topic-1", "state": "visited", "is": true } },
                  { "object_state": { "object": "s02-topic-2", "state": "visited", "is": true } },
                  { "object_state": { "object": "s02-topic-3", "state": "visited", "is": true } }
                ]
              },
              "action": { "action": "change_state", "object": "s02-btn-continue", "state": "normal" }
            },
            {
              "when": { "event": "state_changes", "object": "s02-topic-3" },
              "condition": {
                "all": [
                  { "object_state": { "object": "s02-topic-1", "state": "visited", "is": true } },
                  { "object_state": { "object": "s02-topic-2", "state": "visited", "is": true } },
                  { "object_state": { "object": "s02-topic-3", "state": "visited", "is": true } }
                ]
              },
              "action": { "action": "change_state", "object": "s02-btn-continue", "state": "normal" }
            },
            {
              "when": { "event": "click", "object": "s02-btn-continue" },
              "action": { "action": "jump_to_slide", "target": "next" }
            }
          ]
        },
        {
          "id": "s03-cards-keep",
          "title": "Flip Cards (Keep Saved)",
          "revisit": "resume",
          "objects": [
            {
              "id": "s03-heading",
              "kind": { "type": "text", "text": "Interactive Cards (Keep Saved)", "style": { "size": 30.0, "bold": true, "color": "#0F172A" } },
              "frame": { "x": 80, "y": 48, "w": 720, "h": 52 }
            },
            {
              "id": "s03-card-a",
              "kind": {
                "type": "shape",
                "shape": "rounded_rectangle",
                "fill": "#E2E8F0",
                "text": { "text": "Card A: Hover & Press" }
              },
              "frame": { "x": 140, "y": 180, "w": 300, "h": 220 },
              "states": [
                {
                  "name": "selected",
                  "fill": "#DBEAFE",
                  "fill_style": {
                    "type": "linear",
                    "angle": 45,
                    "stops": [
                      { "position": 0.0, "color": "#DBEAFE" },
                      { "position": 1.0, "color": "#BFDBFE" }
                    ]
                  },
                  "outline": { "color": "#2563EB", "width": 3.0, "dash": "dash" },
                  "shadow": { "color": "#1E3A8A40", "offset_x": 0.0, "offset_y": 6.0, "blur": 14.0 },
                  "text_style": { "size": 20.0, "bold": true, "color": "#1E3A8A" },
                  "runs": [
                    { "text": "Selected: ", "bold": true },
                    { "text": "Key Insight" }
                  ],
                  "extras": [
                    {
                      "id": "s03-badge-a",
                      "name": "Info badge",
                      "kind": {
                        "type": "image",
                        "src": "media/badge-info.svg",
                        "alt": "Selected info badge"
                      },
                      "frame": { "x": 248, "y": 12, "w": 36, "h": 36 }
                    }
                  ]
                }
              ]
            },
            {
              "id": "s03-card-b",
              "kind": {
                "type": "shape",
                "shape": "rounded_rectangle",
                "fill": "#E2E8F0",
                "text": { "text": "Card B: State Extras" }
              },
              "frame": { "x": 520, "y": 180, "w": 300, "h": 220 },
              "states": [
                {
                  "name": "selected",
                  "fill": "#DBEAFE",
                  "outline": { "color": "#2563EB", "width": 3.0, "dash": "dash" },
                  "shadow": { "color": "#1E3A8A40", "offset_x": 0.0, "offset_y": 6.0, "blur": 14.0 }
                }
              ]
            },
            {
              "id": "s03-btn-next",
              "kind": { "type": "button", "label": "Next" },
              "frame": { "x": 1020, "y": 620, "w": 180, "h": 52 }
            }
          ],
          "triggers": [
            {
              "when": { "event": "click", "object": "s03-card-a" },
              "action": { "action": "change_state", "object": "s03-card-a", "state": "selected" }
            },
            {
              "when": { "event": "click", "object": "s03-card-b" },
              "action": { "action": "change_state", "object": "s03-card-b", "state": "selected" }
            },
            {
              "when": { "event": "click", "object": "s03-btn-next" },
              "action": { "action": "jump_to_slide", "target": "next" }
            }
          ]
        },
        {
          "id": "s03b-cards-reset",
          "title": "Flip Cards (Reset)",
          "revisit": "reset",
          "objects": [
            {
              "id": "s03b-heading",
              "kind": { "type": "text", "text": "Interactive Cards (Reset on Revisit)", "style": { "size": 30.0, "bold": true, "color": "#0F172A" } },
              "frame": { "x": 80, "y": 48, "w": 760, "h": 52 }
            },
            {
              "id": "s03b-card-a",
              "kind": {
                "type": "shape",
                "shape": "rounded_rectangle",
                "fill": "#E2E8F0",
                "text": { "text": "Resettable Card A" }
              },
              "frame": { "x": 140, "y": 180, "w": 300, "h": 220 },
              "states": [
                {
                  "name": "selected",
                  "fill": "#DCFCE7",
                  "outline": { "color": "#16A34A", "width": 3.0 }
                }
              ]
            },
            {
              "id": "s03b-btn-back",
              "kind": { "type": "button", "label": "Back" },
              "frame": { "x": 800, "y": 620, "w": 180, "h": 52 }
            },
            {
              "id": "s03b-btn-next",
              "kind": { "type": "button", "label": "Next" },
              "frame": { "x": 1020, "y": 620, "w": 180, "h": 52 }
            }
          ],
          "triggers": [
            {
              "when": { "event": "click", "object": "s03b-card-a" },
              "action": { "action": "change_state", "object": "s03b-card-a", "state": "selected" }
            },
            {
              "when": { "event": "click", "object": "s03b-btn-back" },
              "action": { "action": "jump_to_slide", "target": "previous" }
            },
            {
              "when": { "event": "click", "object": "s03b-btn-next" },
              "action": { "action": "jump_to_slide", "target": "next" }
            }
          ]
        },
        {
          "id": "s04-question",
          "title": "Custom State Question",
          "question": {
            "kind": "freeform",
            "prompt": "Select the two cards that belong to rich object states:",
            "correct_layer": "correct",
            "incorrect_layer": "incorrect",
            "choices": [],
            "points": 100,
            "correct_when": {
              "all": [
                { "object_state": { "object": "s04-ans-1", "state": "selected", "is": true } },
                { "object_state": { "object": "s04-ans-2", "state": "selected", "is": true } },
                { "object_state": { "object": "s04-ans-3", "state": "selected", "is": false } }
              ]
            }
          },
          "objects": [
            {
              "id": "s04-prompt",
              "kind": { "type": "text", "text": "Select the two correct state features:", "style": { "size": 28.0, "bold": true, "color": "#0F172A" } },
              "frame": { "x": 80, "y": 48, "w": 820, "h": 52 }
            },
            {
              "id": "s04-ans-1",
              "kind": {
                "type": "shape",
                "shape": "rounded_rectangle",
                "fill": "#E2E8F0",
                "text": { "text": "Parent-relative StateExtras" }
              },
              "frame": { "x": 100, "y": 180, "w": 280, "h": 140 },
              "states": [
                {
                  "name": "selected",
                  "fill": "#DBEAFE",
                  "outline": { "color": "#2563EB", "width": 3.0 },
                  "extras": [
                    {
                      "id": "s04-chosen-1",
                      "name": "Chosen label",
                      "kind": { "type": "text", "text": "Chosen", "style": { "size": 14.0, "bold": true, "color": "#1D4ED8" } },
                      "frame": { "x": 12, "y": 104, "w": 100, "h": 24 }
                    }
                  ]
                }
              ]
            },
            {
              "id": "s04-ans-2",
              "kind": {
                "type": "shape",
                "shape": "rounded_rectangle",
                "fill": "#E2E8F0",
                "text": { "text": "Two-layer hover & visited" }
              },
              "frame": { "x": 440, "y": 180, "w": 280, "h": 140 },
              "states": [
                {
                  "name": "selected",
                  "fill": "#DBEAFE",
                  "outline": { "color": "#2563EB", "width": 3.0 }
                }
              ]
            },
            {
              "id": "s04-ans-3",
              "kind": {
                "type": "shape",
                "shape": "rounded_rectangle",
                "fill": "#E2E8F0",
                "text": { "text": "Unrelated distractor" }
              },
              "frame": { "x": 780, "y": 180, "w": 280, "h": 140 },
              "states": [
                {
                  "name": "selected",
                  "fill": "#FEE2E2",
                  "outline": { "color": "#DC2626", "width": 3.0 }
                }
              ]
            },
            {
              "id": "s04-btn-submit",
              "kind": { "type": "button", "label": "Submit Answer" },
              "frame": { "x": 1000, "y": 620, "w": 200, "h": 52 }
            }
          ],
          "layers": [
            {
              "id": "correct",
              "name": "Correct",
              "objects": [
                {
                  "id": "s04-fb-ok",
                  "kind": { "type": "text", "text": "Correct!", "style": { "size": 24.0, "bold": true, "color": "#15803D" } },
                  "frame": { "x": 100, "y": 420, "w": 300, "h": 44 }
                },
                {
                  "id": "s04-btn-finish",
                  "kind": { "type": "button", "label": "Continue" },
                  "frame": { "x": 100, "y": 480, "w": 180, "h": 48 }
                }
              ],
              "triggers": [
                {
                  "when": { "event": "click", "object": "s04-btn-finish" },
                  "action": { "action": "jump_to_slide", "target": "next" }
                }
              ]
            },
            {
              "id": "incorrect",
              "name": "Incorrect",
              "objects": [
                {
                  "id": "s04-fb-no",
                  "kind": { "type": "text", "text": "Not quite.", "style": { "size": 24.0, "bold": true, "color": "#B91C1C" } },
                  "frame": { "x": 100, "y": 420, "w": 300, "h": 44 }
                },
                {
                  "id": "s04-btn-finish-inc",
                  "kind": { "type": "button", "label": "Continue" },
                  "frame": { "x": 100, "y": 480, "w": 180, "h": 48 }
                }
              ],
              "triggers": [
                {
                  "when": { "event": "click", "object": "s04-btn-finish-inc" },
                  "action": { "action": "jump_to_slide", "target": "next" }
                }
              ]
            }
          ],
          "triggers": [
            {
              "when": { "event": "click", "object": "s04-ans-1" },
              "action": { "action": "change_state", "object": "s04-ans-1", "state": "selected" }
            },
            {
              "when": { "event": "click", "object": "s04-ans-2" },
              "action": { "action": "change_state", "object": "s04-ans-2", "state": "selected" }
            },
            {
              "when": { "event": "click", "object": "s04-ans-3" },
              "action": { "action": "change_state", "object": "s04-ans-3", "state": "selected" }
            },
            {
              "when": { "event": "click", "object": "s04-btn-submit" },
              "action": { "action": "submit_question" }
            }
          ]
        },
        {
          "id": "s05-done",
          "title": "Complete",
          "objects": [
            {
              "id": "s05-heading",
              "kind": { "type": "text", "text": "Course Complete — Score: %Course.ScorePercent%%%", "style": { "size": 32.0, "bold": true, "color": "#0F172A" } },
              "frame": { "x": 80, "y": 160, "w": 900, "h": 60 }
            }
          ],
          "triggers": [
            {
              "when": { "event": "timeline_starts" },
              "action": { "action": "submit_results" }
            }
          ]
        }
      ]
    }
  ]
}
